# ============================================================================
# Doudou 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交。
#
# 命名规则只有一条：
#   DOUDOU_ + config.yaml 的路径，层级用下划线连接
#
#   config.yaml                    .env
#   -----------------------------  ------------------------------------------
#   server.port                    DOUDOU_SERVER_PORT
#   model.primary                  DOUDOU_MODEL_PRIMARY
#   model.max_tokens               DOUDOU_MODEL_MAX_TOKENS
#   tools.web_search.provider      DOUDOU_TOOLS_WEB_SEARCH_PROVIDER
#   channels.feishu.app_secret     DOUDOU_CHANNELS_FEISHU_APP_SECRET
#
# 环境变量优先级高于 config.yaml。列表/字典字段写 JSON：
#   DOUDOU_MODEL_FALLBACKS='["openai:gpt-5.5"]'
#
# 凭据也是配置字段，只是约定「只放 .env」。
# ============================================================================

# ---------------------------------------------------------------- 运行环境
DOUDOU_RUNTIME_ENV=local                     # local | dev | prod
DOUDOU_RUNTIME_DEBUG=true
DOUDOU_RUNTIME_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
DOUDOU_RUNTIME_LOG_JSON=false                # prod 建议 true
DOUDOU_RUNTIME_TIMEZONE=Asia/Shanghai

DOUDOU_SERVER_HOST=127.0.0.1
DOUDOU_SERVER_PORT=8000
DOUDOU_SERVER_WORKERS=1
DOUDOU_FILESYSTEM_ROOT_DIR=~/.doudou/workspace

# 整个运行时目录的根（默认 ~/.doudou）；也决定默认 config/data/workspace/skills 位置
# DOUDOU_HOME=~/.doudou
# 配置目录与主配置文件位置（默认 ~/.doudou/config 与 config.yaml）
# DOUDOU_CONFIG_DIR=~/.doudou/config
# DOUDOU_CONFIG_FILE=config.yaml
# 显式指定 .env 路径（默认先找当前目录 .env，再找 ~/.doudou/.env）
# DOUDOU_ENV_FILE=~/.doudou/.env

# ---------------------------------------------------------------- 模型
# provider:model；provider 决定要装哪个 langchain 集成包
# scripted:demo 是内置离线模型，不需要任何凭据，用于自检
DOUDOU_MODEL_PRIMARY=openai:gpt-5.5
DOUDOU_MODEL_TEMPERATURE=0.2
DOUDOU_MODEL_MAX_TOKENS=4096
DOUDOU_MODEL_TIMEOUT=120
DOUDOU_MODEL_MAX_RETRIES=2

# 模型凭据（只放 .env）
DOUDOU_MODEL_API_KEY=
# 自建/兼容 OpenAI 协议的网关地址
DOUDOU_MODEL_BASE_URL=

# 多个 provider 各自的 key / 地址（JSON 对象）
# DOUDOU_MODEL_API_KEYS='{"openai": "sk-...", "anthropic": "sk-ant-..."}'
# DOUDOU_MODEL_BASE_URLS='{"openai": "https://gateway.example/v1"}'

# ---------------------------------------------------------------- Agent
DOUDOU_AGENT_NAME=Doudou
DOUDOU_AGENT_MAX_STEPS=8                     # ReAct 循环单次运行的最大步数
DOUDOU_AGENT_SKILL_INDEX_LIMIT=40
# 需要人工确认的工具（JSON 对象）
# DOUDOU_AGENT_INTERRUPT_ON='{"workspace_write": false}'

# ---------------------------------------------------------------- API 安全
DOUDOU_API_TOKEN=                            # 非空时 /api 接口需 Bearer <token>

# ---------------------------------------------------------------- 上下文工程
# 送进模型的历史 token 预算。**最关键的一个数**：默认 80000 刻意保守。
DOUDOU_CONTEXT_MAX_INPUT_TOKENS=80000
DOUDOU_CONTEXT_SUMMARIZE_THRESHOLD_RATIO=0.7
DOUDOU_CONTEXT_KEEP_RECENT_MESSAGES=12
DOUDOU_CONTEXT_SUMMARIZATION=true
DOUDOU_CONTEXT_OFFLOAD_LARGE_RESULTS=true
DOUDOU_CONTEXT_OFFLOAD_THRESHOLD_BYTES=20000
DOUDOU_CONTEXT_MAX_MEMORY_CHARS=8000

# ---------------------------------------------------------------- 存储
DOUDOU_STORAGE_DATABASE_URL=sqlite+aiosqlite:///~/.doudou/data/doudou.db
# DOUDOU_STORAGE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/doudou
DOUDOU_STORAGE_HISTORY=database              # database | memory
DOUDOU_STORAGE_MAX_MESSAGES_PER_THREAD=500

# ---------------------------------------------------------------- 飞书 / Lark
DOUDOU_CHANNELS_FEISHU_ENABLED=false
DOUDOU_CHANNELS_FEISHU_MODE=websocket        # websocket | callback
DOUDOU_CHANNELS_FEISHU_BOT_NAME=Doudou       # 群聊 @ 判定用
DOUDOU_CHANNELS_FEISHU_GROUP_REQUIRE_AT=true
DOUDOU_CHANNELS_FEISHU_ISOLATE_BY_THREAD=false
# 白名单写 JSON 数组（不要用逗号分隔）
# DOUDOU_CHANNELS_FEISHU_ALLOWED_CHATS='["oc_xxx"]'

# 飞书凭据（只放 .env）
DOUDOU_CHANNELS_FEISHU_APP_ID=
DOUDOU_CHANNELS_FEISHU_APP_SECRET=
DOUDOU_CHANNELS_FEISHU_BASE_URL=https://open.feishu.cn   # 国际版用 open.larksuite.com
# 仅 callback 模式需要：
DOUDOU_CHANNELS_FEISHU_VERIFICATION_TOKEN=
DOUDOU_CHANNELS_FEISHU_ENCRYPT_KEY=

# ---------------------------------------------------------------- MCP
# server 清单在 config/config.yaml 的 mcp.servers 里（不再单独一个文件）；
# 清单里可以用 ${VAR} 占位，把密钥放这里，例如 github server 的：
# GITHUB_TOKEN=
DOUDOU_MCP_ENABLED=true

# ---------------------------------------------------------------- 工具
# 分组开关（JSON 数组；留空 = 全部启用）
# DOUDOU_TOOLS_ENABLED_GROUPS='["clock","files"]'
# DOUDOU_TOOLS_DISABLED='["http_request"]'

# http_request 的域名允许列表。**留空则该工具不注册**（默认拒绝一切出站请求）。
# DOUDOU_TOOLS_HTTP_ALLOWED_DOMAINS='["docs.python.org","api.github.com"]'

# 联网搜索：provider 为 tavily 或 deepseek，key 都放在同一个路径
# DOUDOU_TOOLS_WEB_SEARCH_PROVIDER=tavily
# DOUDOU_TOOLS_WEB_SEARCH_API_KEY=
# DOUDOU_TOOLS_WEB_SEARCH_MAX_RESULTS=5

# 命令执行（默认关闭）。打开后建议同时启用沙箱（仅 Linux，需要 bubblewrap）：
# DOUDOU_TOOLS_SHELL_ENABLED=true
# DOUDOU_TOOLS_SHELL_SANDBOX=bwrap

# ---------------------------------------------------------------- 可观测性
# DOUDOU_OBSERVABILITY_AUDIT_ENABLED=true
# DOUDOU_OBSERVABILITY_AUDIT_BATCH_SIZE=50       # 1 = 逐条严格持久化
# DOUDOU_OBSERVABILITY_AUDIT_MAX_ROWS=50000
# DOUDOU_OBSERVABILITY_COST_ENABLED=true
# DOUDOU_OBSERVABILITY_COST_DAILY_BUDGET=5       # 0 = 不设；超了只告警

# 运行轨迹：本地落库（run_traces 表），供 /traces 与 /stats 使用。
# 无需任何 key；用 max_rows 压住增长、max_text_chars 截断单段文本。
# DOUDOU_OBSERVABILITY_TRACES_ENABLED=true
# DOUDOU_OBSERVABILITY_TRACES_MAX_ROWS=20000
# DOUDOU_OBSERVABILITY_TRACES_MAX_TEXT_CHARS=1000

# ---------------------------------------------------------------- 定时任务
# DOUDOU_SCHEDULER_ENABLED=true
# DOUDOU_SCHEDULER_TICK_SECONDS=30
# DOUDOU_SCHEDULER_OWNER_USER_ID=          # CLI/Web 任务的飞书私聊归属（open_id）
# DOUDOU_SCHEDULER_MAX_TASKS=200
