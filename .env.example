# ============================================================================
# Doudou 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交。
#
# 两套命名约定：
#   1) DOUDOU_*  —— 配置项覆盖，嵌套字段用双下划线分隔
#      例：DOUDOU_SERVER__PORT=8000 对应 config.yaml 的 server.port
#   2) 无前缀    —— 只放凭据，沿用各家官方环境变量名（OPENAI_API_KEY 等）
#      无前缀的值不会被写进 config.yaml，也就不会被提交
# ============================================================================

# ---------------------------------------------------------------- 运行环境
DOUDOU_RUNTIME__ENV=local                    # local | dev | prod
DOUDOU_RUNTIME__DEBUG=true
DOUDOU_RUNTIME__LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
DOUDOU_RUNTIME__LOG_JSON=false               # prod 建议 true
DOUDOU_RUNTIME__TIMEZONE=Asia/Shanghai

DOUDOU_SERVER__HOST=127.0.0.1
DOUDOU_SERVER__PORT=8000
DOUDOU_SERVER__WORKERS=1
DOUDOU_FILESYSTEM__ROOT_DIR=./data

# 配置目录与主配置文件位置（默认 ./config 与 config.yaml）
# DOUDOU_CONFIG_DIR=./config
# DOUDOU_CONFIG_FILE=config.yaml

# ---------------------------------------------------------------- 模型
# provider:model；provider 决定要装哪个 langchain 集成包
# scripted:demo 是内置离线模型，不需要任何凭据，用于自检
DOUDOU_MODEL__PRIMARY=openai:gpt-5.5
DOUDOU_MODEL__TEMPERATURE=0.2
DOUDOU_MODEL__MAX_TOKENS=4096
DOUDOU_MODEL__TIMEOUT=120
DOUDOU_MODEL__MAX_RETRIES=2

# ---------------------------------------------------------------- Agent
DOUDOU_AGENT__NAME=Doudou
DOUDOU_AGENT__MAX_STEPS=8                    # ReAct 循环单次运行的最大步数
DOUDOU_AGENT__RECURSION_LIMIT=60
# 提示词里最多列几个技能（索引必须有界）
DOUDOU_AGENT__SKILL_INDEX_LIMIT=40

# ---------------------------------------------------------------- 凭据（无前缀）
OPENAI_API_KEY=
OPENAI_BASE_URL=                             # 兼容 OpenAI 协议的自建网关时填写

ANTHROPIC_API_KEY=                           # 需要 uv sync --extra anthropic
DEEPSEEK_API_KEY=                            # 需要 uv sync --extra deepseek
TAVILY_API_KEY=                              # 内置 web_search 工具（M1.5 落地）

# ---------------------------------------------------------------- API 安全
DOUDOU_API_TOKEN=                            # 非空时，/api 接口需携带 Authorization: Bearer <token>

# ---------------------------------------------------------------- 上下文工程（M7）
# 送进模型的历史 token 预算。**最关键的一个数**：默认 80000 刻意保守，
# 100 万上下文的大模型可以调到 300000 甚至更高。
DOUDOU_CONTEXT__MAX_INPUT_TOKENS=80000
DOUDOU_CONTEXT__SUMMARIZE_THRESHOLD_RATIO=0.7
DOUDOU_CONTEXT__SUMMARIZE_AFTER_MESSAGES=40
DOUDOU_CONTEXT__KEEP_RECENT_MESSAGES=12
DOUDOU_CONTEXT__SUMMARIZATION=true
# 超大工具结果落盘（默认 <root_dir>/.offload，必须在工作区内）
DOUDOU_CONTEXT__OFFLOAD_LARGE_RESULTS=true
DOUDOU_CONTEXT__OFFLOAD_THRESHOLD_BYTES=20000
DOUDOU_CONTEXT__MAX_MEMORY_CHARS=8000

# ---------------------------------------------------------------- 存储
DOUDOU_STORAGE__DATABASE_URL=sqlite+aiosqlite:///./data/doudou.db
# DOUDOU_STORAGE__DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/doudou
# 会话历史存哪：database = 落库（重启可续）；memory = 只在进程内（轻量、适合 CI）
DOUDOU_STORAGE__HISTORY=database
# 库里保留的消息条数（保留，不是送进模型的窗口）
DOUDOU_STORAGE__MAX_MESSAGES_PER_THREAD=500
DOUDOU_STORAGE__CHECKPOINTER=sqlite          # 未使用：LangGraph 概念，接入 deepagents 的计划已取消
DOUDOU_STORAGE__STORE=sqlite

# ---------------------------------------------------------------- 飞书 / Lark（M4 已落地）
# 长连接模式：无需公网地址，事件由 SDK 主动推给你（不需要 Verification Token）
DOUDOU_CHANNELS__FEISHU__ENABLED=false
DOUDOU_CHANNELS__FEISHU__MODE=websocket      # websocket | callback（callback 尚未实现）
DOUDOU_CHANNELS__FEISHU__BOT_NAME=Doudou     # 群聊 @ 判定用，需与飞书里的显示名一致
DOUDOU_CHANNELS__FEISHU__GROUP_REQUIRE_AT=true
DOUDOU_CHANNELS__FEISHU__ISOLATE_BY_THREAD=false  # false = 同一个群共享一个上下文
DOUDOU_CHANNELS__FEISHU__ALLOWED_CHATS=      # 逗号分隔的 chat_id 白名单

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn       # 国际版填 https://open.larksuite.com
# 下面两项只在 callback 模式（尚未实现）下需要：
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------------------------------------------------------------- MCP
DOUDOU_MCP__ENABLED=true
DOUDOU_MCP__CONFIG_FILE=mcp.servers.yaml

# ---------------------------------------------------------------- 工具
# 分组开关：DOUDOU_TOOLS__ENABLED_GROUPS='["clock","notes"]'（留空 = 全部）
# DOUDOU_TOOLS__ENABLED_GROUPS=
# DOUDOU_TOOLS__DISABLED='["http_request"]'

# http_request 的域名允许列表。**留空则该工具不注册**（默认拒绝一切出站请求）。
# DOUDOU_TOOLS__HTTP__ALLOWED_DOMAINS='["docs.python.org","api.github.com"]'
DOUDOU_TOOLS__HTTP__ALLOWED_DOMAINS=

# DOUDOU_TOOLS__WEB_SEARCH__MAX_RESULTS=5
# DOUDOU_TOOLS__NOTES__DIRECTORY=./data/notes

# ---------------------------------------------------------------- 可观测性
DOUDOU_OBSERVABILITY__LANGSMITH__ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doudou
